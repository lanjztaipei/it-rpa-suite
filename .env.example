# IT RPA Suite 環境變數範例（複製為 .env 後依需求調整，切勿提交真實機密）

# 本機離線企業沙盒伺服器位址（預設自動掛載於 http://127.0.0.1:8000，被佔用時自動遞增至 8020）
IT_SUITE_SANDBOX_URL=http://127.0.0.1:8000

# 是否啟用沙盒模式（預設 true 允許離線展示使用範例帳密；設為 false 進入正式模式，缺憑證或解密失敗立即報錯）
IT_SUITE_SANDBOX_MODE=true

# 覆寫工具箱獨立腳本定位的專案／應用程式根目錄（留空則自動偵測）
IT_SUITE_BASE_DIR=

# 覆寫三階段自動更新器來源壓縮包路徑（留空則預設尋找 released/ITRPASuite.zip）
IT_SUITE_UPDATE_ZIP=

# 選填：指定更新壓縮包預期之 SHA-256 雜湊值（留空時若同目錄存在 .sha256 校驗檔亦會自動比對）
IT_SUITE_UPDATE_SHA256=

# 啟動後自動關閉主視窗的毫秒數（僅供自動化冒煙測試使用，一般使用請留空）
IT_SUITE_AUTO_CLOSE_MS=

# 設為 1 / true 時強制停用 Classic Outlook COM，改以內建 HTML 預覽視窗降級顯示郵件草稿
IT_SUITE_FORCE_EMAIL_FALLBACK=false

# 外部工具 SDK 是否忽略自簽 HTTPS 憑證錯誤（預設 false 強制校驗 TLS；僅內網自簽憑證時設為 true）
IT_SUITE_IGNORE_HTTPS_ERRORS=false
